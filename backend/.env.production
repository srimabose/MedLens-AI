# Production Environment Variables
# Copy this file to .env and fill in your actual values

# AI Configuration
GEMINI_API_KEY=your_production_gemini_api_key

# Database Configuration
MONGODB_URL=your_production_mongodb_atlas_url
DATABASE_NAME=medlens_ai

# Authentication & Security
SECRET_KEY=your_super_secure_jwt_secret_key_for_production_at_least_32_characters_long

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
FACEBOOK_CLIENT_ID=your_production_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_production_facebook_client_secret

# Frontend URL (will be set by Render automatically)
FRONTEND_URL=https://your-frontend-app.onrender.com